# BirdVision India Environment Configuration
# Copy this file to .env and update with your actual values

# Roboflow API Configuration
ROBOFLOW_API_KEY=your-roboflow-api-key-here

# Flask Configuration
SECRET_KEY=birdvision-india-secret-key-2024
FLASK_ENV=development
FLASK_DEBUG=True

# Optional: Custom model paths (if different from defaults)
# AUDIO_MODEL_PATH=model_16_val_loss_0.1970.keras
# METADATA_CSV_PATH=train_metadata - Copy.csv

# Optional: Custom confidence thresholds
# CONFIDENCE_THRESHOLD=0.78
# AUDIO_CONFIDENCE_THRESHOLD=0.85

# Optional: Server configuration
# HOST=0.0.0.0
# PORT=5000